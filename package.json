{
  "name": "terminal-app",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code 並行セッション監視タイルダッシュボード（Windows 11 常駐・Electron）",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "start": "electron .",
    "smoke:win32": "node scripts/win32-smoke.mjs",
    "diagnose": "node scripts/diagnose.mjs"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.5.0",
    "electron": "^37.0.0",
    "eslint": "^9.9.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vitest": "^3.0.0"
  }
}
